<Page
    x:Class="Skyggn.Pages.FileTypesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Skyggn.Models"
    Loaded="OnLoaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}"
                        Spacing="{StaticResource CardSpacing}">
                <TextBlock x:Uid="FileTypesTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="FileTypesIntro" TextWrapping="Wrap" Margin="0,-8,0,16"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <InfoBar x:Name="OffBar" x:Uid="OffBar" Severity="Warning" IsOpen="False" IsClosable="False" />
                <InfoBar x:Name="ErrorBar" x:Uid="ErrorBar" Severity="Error" IsOpen="False" />
                <!-- appears once a change leaves windows' stored thumbnails out of date -->
                <InfoBar x:Name="RefreshBar" x:Uid="RefreshBar" Severity="Informational" IsOpen="False">
                    <InfoBar.ActionButton>
                        <Button x:Uid="RefreshNowButton" Click="OnRefreshNowClick" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ItemsControl x:Name="Groups">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection />
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:FileTypeGroup">
                            <controls:SettingsExpander Margin="0,0,0,4"
                                                       Header="{x:Bind Title}"
                                                       Description="{x:Bind Description}">
                                <controls:SettingsExpander.HeaderIcon>
                                    <FontIcon Glyph="{x:Bind Glyph}" />
                                </controls:SettingsExpander.HeaderIcon>
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <controls:SettingsExpander.Items>
                                    <controls:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                                        <StackPanel Spacing="12">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Uid="AllButton" Click="{x:Bind TurnAllOn}" />
                                                <Button x:Uid="RecommendedButton" Click="{x:Bind TurnRecommendedOn}" />
                                                <Button x:Uid="NoneButton" Click="{x:Bind TurnAllOff}" />
                                            </StackPanel>
                                            <ItemsRepeater ItemsSource="{x:Bind Types}">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="104" MinColumnSpacing="4" MinRowSpacing="0"
                                                                       ItemsStretch="Fill" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="models:FileTypeItem">
                                                        <CheckBox Content="{x:Bind Extension}"
                                                                  IsChecked="{x:Bind IsOn, Mode=TwoWay}" />
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </controls:SettingsCard>
                                </controls:SettingsExpander.Items>
                            </controls:SettingsExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- appears while there are changes to apply -->
        <Border x:Name="ApplyBar" Grid.Row="1" Visibility="Collapsed" Padding="36,12"
                Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="{StaticResource PageMaxWidth}">
                <TextBlock x:Name="PendingText" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Uid="DiscardButton" Click="OnDiscardClick" />
                    <Button x:Name="ApplyButton" x:Uid="ApplyButton" Style="{StaticResource AccentButtonStyle}"
                            Click="OnApplyClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="ApplyShield" Glyph="&#xE83D;" FontSize="14" />
                            <TextBlock x:Uid="ApplyText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

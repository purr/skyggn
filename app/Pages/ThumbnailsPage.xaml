<Page
    x:Class="Skyggn.Pages.ThumbnailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:Skyggn.Models"
    Loaded="OnLoaded">

    <!-- the setting cards' descriptions come from the engine, which skyggnctl shows too -->
    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" MaxWidth="{StaticResource PageMaxWidth}"
                    Spacing="{StaticResource CardSpacing}">
            <TextBlock x:Uid="ThumbnailsTitle" Style="{StaticResource PageTitleStyle}" />

            <InfoBar x:Name="ErrorBar" x:Uid="ErrorBar" Severity="Error" IsOpen="False" Margin="0,0,0,12" />
            <!-- appears once a change leaves windows' stored thumbnails out of date -->
            <InfoBar x:Name="RefreshBar" x:Uid="RefreshBar" Severity="Informational" IsOpen="False" Margin="0,0,0,12">
                <InfoBar.ActionButton>
                    <Button x:Uid="RefreshNowButton" Click="OnRefreshNowClick" />
                </InfoBar.ActionButton>
            </InfoBar>

            <controls:SettingsExpander x:Uid="PreviewExpander" IsExpanded="True">
                <controls:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE890;" />
                </controls:SettingsExpander.HeaderIcon>
                <Button x:Uid="ChooseButton" Click="OnChooseClick" />
                <controls:SettingsExpander.Items>
                    <controls:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Vertical">
                        <ItemsRepeater x:Name="Previews">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="272" MinColumnSpacing="8" MinRowSpacing="8"
                                                   ItemsJustification="Center" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="models:PreviewItem">
                                    <StackPanel Spacing="4">
                                        <Grid Height="272" Width="272">
                                            <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="None" />
                                            <TextBlock Text="{x:Bind Hint, Mode=OneWay}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Label}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="272" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </controls:SettingsCard>
                </controls:SettingsExpander.Items>
            </controls:SettingsExpander>

            <TextBlock x:Uid="LookHeader" Style="{StaticResource SectionHeaderStyle}" />

            <controls:SettingsCard x:Name="BadgeCard" x:Uid="BadgeCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8EC;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BadgeBox" MinWidth="240" SelectionChanged="OnBadgeChanged">
                    <ComboBoxItem x:Uid="BadgeNone" />
                    <ComboBoxItem x:Uid="BadgeFrosted" />
                    <ComboBoxItem x:Uid="BadgeTinted" />
                    <ComboBoxItem x:Uid="BadgeLabelled" />
                </ComboBox>
            </controls:SettingsCard>

            <!-- the items follow the engine's corner values: 0 bottom right, 1 bottom left, 2 top right, 3 top left -->
            <controls:SettingsCard x:Name="BadgeCornerCard" x:Uid="BadgeCornerCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE740;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BadgeCornerBox" MinWidth="240" SelectionChanged="OnBadgeCornerChanged">
                    <ComboBoxItem x:Uid="CornerBottomRight" />
                    <ComboBoxItem x:Uid="CornerBottomLeft" />
                    <ComboBoxItem x:Uid="CornerTopRight" />
                    <ComboBoxItem x:Uid="CornerTopLeft" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="BadgeSizeCard" x:Uid="BadgeSizeCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A3;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="BadgeSizeSlider" Width="220" StepFrequency="1" TickFrequency="4"
                            TickPlacement="Outside" ValueChanged="OnBadgeSizeChanged" />
                    <TextBlock x:Name="BadgeSizeText" Width="40" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="PlaceholderCard" x:Uid="PlaceholderCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B9;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="PlaceholderBox" MinWidth="240" SelectionChanged="OnPlaceholderChanged">
                    <ComboBoxItem x:Uid="PlaceholderNone" />
                    <ComboBoxItem x:Uid="PlaceholderKind" />
                    <ComboBoxItem x:Uid="PlaceholderPerFile" />
                </ComboBox>
            </controls:SettingsCard>

            <TextBlock x:Uid="VideosHeader" Style="{StaticResource SectionHeaderStyle}" />

            <controls:SettingsCard x:Name="PositionCard" x:Uid="PositionCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Slider x:Name="PositionSlider" Width="220" StepFrequency="5" TickFrequency="10"
                            TickPlacement="Outside" ValueChanged="OnPositionChanged" />
                    <TextBlock x:Name="PositionText" Width="40" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="BlackFramesCard" x:Uid="BlackFramesCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE793;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="BlackFramesSwitch" Toggled="OnBlackFramesToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="CoverArtCard" x:Uid="CoverArtCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C3;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="CoverArtSwitch" Toggled="OnCoverArtToggled" />
            </controls:SettingsCard>

            <TextBlock x:Uid="PerformanceHeader" Style="{StaticResource SectionHeaderStyle}" />

            <controls:SettingsCard x:Name="LowImpactCard" x:Uid="LowImpactCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC4A;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="LowImpactSwitch" Toggled="OnLowImpactToggled" />
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="TimeLimitCard" x:Uid="TimeLimitCard">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;" />
                </controls:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox x:Name="TimeLimitBox" Width="120" SpinButtonPlacementMode="Compact"
                               SmallChange="0.5" LargeChange="5" ValueChanged="OnTimeLimitChanged" />
                    <TextBlock x:Uid="SecondsText" VerticalAlignment="Center" />
                </StackPanel>
            </controls:SettingsCard>

        </StackPanel>
    </ScrollViewer>
</Page>

<Application
    x:Class="Skyggn.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- page layout shared by every page, as in windows settings -->
            <Thickness x:Key="PagePadding">36,24,36,36</Thickness>
            <x:Double x:Key="PageMaxWidth">1000</x:Double>
            <x:Double x:Key="CardSpacing">4</x:Double>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
